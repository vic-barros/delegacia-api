          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/usuario-logado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "usuario-logado"
              ]
            },
            "description": "Lê login, nome e papel direto do token. Requer `Login Admin` antes.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
