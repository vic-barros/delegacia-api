    {
      "name": "Usuários - Cadastro (UC02)",
      "item": [
        {
          "name": "Papéis do cadastro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Não lista ROLE_ADMIN\", () => pm.expect(pm.response.json().map(r => r.acesso)).to.not.include(\"ROLE_ADMIN\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/roles/cadastro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "roles",
                "cadastro"
              ]
            },
            "description": "Público. Lista os papéis para o combo do formulário (sem ROLE_ADMIN). Use o `id` no campo `roleId` do cadastro.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Cadastro válido (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Status PENDENTE e sem senha\", () => {",
                  "  const u = pm.response.json();",
                  "  pm.expect(u.status).to.eql(\"PENDENTE\");",
                  "  pm.expect(u).to.not.have.property(\"senha\");",
                  "  pm.expect(u).to.not.have.property(\"senhaHash\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios/cadastro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "cadastro"
              ]
            },
            "description": "Público. O usuário nasce PENDENTE e os Admins recebem a notificação CADASTRO_PENDENTE. A senha nunca volta na resposta.\n\nObs.: só dá 201 na primeira vez; para repetir, troque login e matrícula.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria Souza\",\n  \"matricula\": \"123456\",\n  \"login\": \"maria.souza\",\n  \"senha\": \"SenhaForte@1\",\n  \"roleId\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
