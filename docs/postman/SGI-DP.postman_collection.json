    {
      "name": "Usuários - Aprovação (UC03)",
      "description": "Rotas só de Admin (rode `Auth > Login Admin` antes). Usa o usuário criado em `Cadastro válido` (variável `usuarioId`) e cria outro para a rejeição. Rode a pasta em ordem, com o banco sem esses logins.",
      "item": [
        {
          "name": "Listar sem token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "description": "Rota protegida: sem token o Spring não sabe quem é o usuário.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Listar pendentes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Só PENDENTE\", () => pm.response.json().forEach(u => pm.expect(u.status).to.eql(\"PENDENTE\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios?status=PENDENTE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "PENDENTE"
                }
              ]
            },
            "description": "Status opcional; sem ele lista todos. Ordem alfabética.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Status inválido (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
