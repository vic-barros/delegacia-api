              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria Souza\",\n  \"matricula\": \"123456\",\n  \"login\": \"maria.souza\",\n  \"senha\": \"SenhaForte@1\",\n  \"roleId\": 3\n}",
