              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Status PENDENTE e sem senha\", () => {",
                  "  const u = pm.response.json();",
                  "  pm.expect(u.status).to.eql(\"PENDENTE\");",
                  "  pm.expect(u).to.not.have.property(\"senha\");",
                  "  pm.expect(u).to.not.have.property(\"senhaHash\");",
                  "});",
                  "pm.collectionVariables.set(\"usuarioId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios/cadastro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "cadastro"
              ]
            },
