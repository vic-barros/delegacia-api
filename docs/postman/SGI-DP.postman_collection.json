                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Mensagem genérica: não informa se o erro foi no login ou na senha.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{adminLogin}}\",\n  \"senha\": \"senha-errada\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
