# Configurações do Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=numero_porta
DB_NAME=nome_do_seu_banco
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# Usuário administrador inicial
ADMIN_LOGIN=admin
ADMIN_PASSWORD=defina_uma_senha_forte

# Configuração de Segurança (JWT)
JWT_SECRET=sua_chave_secreta_com_pelo_menos_32_caracteres

# Origens do frontend autorizadas a chamar a API (separadas por vírgula)
CORS_ORIGENS_PERMITIDAS=http://localhost:4200
